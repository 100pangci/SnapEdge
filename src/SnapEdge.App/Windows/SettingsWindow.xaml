<Window x:Class="SnapEdge.App.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="SnapEdge 设置"
        Icon="pack://application:,,,/SnapEdge;component/Assets/SnapEdge.ico"
        Width="600" Height="760" MinWidth="480" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        Background="#FF0B1218" Foreground="#FFEAF1F3"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">
  <Window.Resources>
    <SolidColorBrush x:Key="AccentBrush" Color="#FF75D6C2" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#FF91E6D5" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFEAF1F3" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#FF91A4AF" />
    <SolidColorBrush x:Key="CardBrush" Color="#FF121C24" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#FF263642" />
    <SolidColorBrush x:Key="ControlBrush" Color="#FF182630" />
    <SolidColorBrush x:Key="TrackBrush" Color="#FF253640" />

    <Style x:Key="CaptionButtonStyle" TargetType="{x:Type Button}">
      <Setter Property="Width" Value="46" />
      <Setter Property="Height" Value="32" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#FFB5C4CB" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Button}">
            <Border Background="{TemplateBinding Background}" CornerRadius="8">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#FF263842" />
          <Setter Property="Foreground" Value="#FFF3F6F8" />
        </Trigger>
        <Trigger Property="IsPressed" Value="True">
          <Setter Property="Opacity" Value="0.72" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="CloseCaptionButtonStyle"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource CaptionButtonStyle}">
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#FFC5483D" />
          <Setter Property="Foreground" Value="#FFFFFFFF" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="SectionCardStyle" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource CardBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="15" />
      <Setter Property="Padding" Value="18" />
      <Setter Property="Margin" Value="0,0,0,14" />
    </Style>

    <Style TargetType="Button">
      <Setter Property="MinHeight" Value="46" />
      <Setter Property="Padding" Value="16,9" />
      <Setter Property="Foreground" Value="#FF10201E" />
      <Setter Property="Background" Value="{StaticResource AccentBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Button}">
            <Border x:Name="ButtonBorder"
                    Background="{TemplateBinding Background}"
                    CornerRadius="10"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                RecognizesAccessKey="True" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource AccentHoverBrush}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.78" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="TextBox">
      <Setter Property="Height" Value="46" />
      <Setter Property="Padding" Value="13,7" />
      <Setter Property="Background" Value="{StaticResource ControlBrush}" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
      <Setter Property="BorderBrush" Value="#FF314651" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type TextBox}">
            <Border x:Name="TextBoxBorder"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="9">
              <ScrollViewer x:Name="PART_ContentHost"
                            Margin="{TemplateBinding Padding}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            HorizontalScrollBarVisibility="Hidden"
                            VerticalScrollBarVisibility="Hidden" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="TextBoxBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="TextBoxBorder" Property="Opacity" Value="0.55" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="MinHeight" Value="50" />
      <Setter Property="Margin" Value="0,3" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type CheckBox}">
            <Grid MinHeight="{TemplateBinding MinHeight}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="25" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border x:Name="CheckBoxIndicator"
                      Width="19" Height="19"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Center"
                      Background="#FF111B22"
                      BorderBrush="#FF40525C"
                      BorderThickness="1.5"
                      CornerRadius="6" />
              <Path x:Name="CheckMark"
                    Grid.Column="0"
                    Width="12" Height="12"
                    HorizontalAlignment="Left"
                    Margin="3,0,0,0"
                    VerticalAlignment="Center"
                    Data="M 1,6 L 4.5,10 L 11,2"
                    Stroke="#FF10201E"
                    StrokeThickness="2.2"
                    StrokeStartLineCap="Round"
                    StrokeEndLineCap="Round"
                    StrokeLineJoin="Round"
                    Visibility="Collapsed" />
              <ContentPresenter Grid.Column="1"
                                Margin="9,0,0,0"
                                VerticalAlignment="Center"
                                RecognizesAccessKey="True"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                ContentStringFormat="{TemplateBinding ContentStringFormat}" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="CheckBoxIndicator" Property="Background" Value="{StaticResource AccentBrush}" />
                <Setter TargetName="CheckBoxIndicator" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="CheckBoxIndicator" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="CheckBoxIndicator" Property="BorderBrush" Value="{StaticResource AccentHoverBrush}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SliderTrackButtonStyle" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="IsTabStop" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type RepeatButton}">
            <Border Height="4"
                    VerticalAlignment="Center"
                    Background="{TemplateBinding Background}"
                    CornerRadius="2" />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SliderThumbStyle" TargetType="Thumb">
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="38" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Thumb}">
            <Grid>
              <Border x:Name="SliderKnob"
                      Width="16" Height="16"
                      VerticalAlignment="Center"
                      Background="{StaticResource AccentBrush}"
                      BorderBrush="#FFD7FFF5"
                      BorderThickness="2"
                      CornerRadius="8" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="SliderKnob" Property="Width" Value="19" />
                <Setter TargetName="SliderKnob" Property="Height" Value="19" />
              </Trigger>
              <Trigger Property="IsDragging" Value="True">
                <Setter TargetName="SliderKnob" Property="Width" Value="20" />
                <Setter TargetName="SliderKnob" Property="Height" Value="20" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="Slider">
      <Setter Property="Height" Value="40" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Slider}">
            <Grid>
              <Track x:Name="PART_Track"
                     Minimum="{TemplateBinding Minimum}"
                     Maximum="{TemplateBinding Maximum}"
                     Value="{TemplateBinding Value}"
                     Orientation="{TemplateBinding Orientation}"
                     IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="{x:Static Slider.DecreaseLarge}"
                                Background="{StaticResource AccentBrush}"
                                Style="{StaticResource SliderTrackButtonStyle}" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                  <Thumb Style="{StaticResource SliderThumbStyle}" />
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="{x:Static Slider.IncreaseLarge}"
                                Background="{StaticResource TrackBrush}"
                                Style="{StaticResource SliderTrackButtonStyle}" />
                </Track.IncreaseRepeatButton>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ScrollPageButtonStyle" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="IsTabStop" Value="False" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type RepeatButton}">
            <Border Background="{TemplateBinding Background}" />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ScrollThumbStyle" TargetType="Thumb">
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Thumb}">
            <Grid Background="Transparent">
              <Border x:Name="ScrollThumb"
                      Width="6"
                      Margin="0,2"
                      HorizontalAlignment="Center"
                      Background="#FF4B8A82"
                      CornerRadius="4" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ScrollThumb" Property="Width" Value="8" />
                <Setter TargetName="ScrollThumb" Property="Background" Value="{StaticResource AccentBrush}" />
              </Trigger>
              <Trigger Property="IsDragging" Value="True">
                <Setter TargetName="ScrollThumb" Property="Width" Value="8" />
                <Setter TargetName="ScrollThumb" Property="Background" Value="{StaticResource AccentHoverBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="18" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ScrollBar}">
            <Grid Width="18" Background="Transparent">
              <Border Width="4"
                      HorizontalAlignment="Center"
                      Background="#FF1A2831"
                      CornerRadius="3" />
              <Track x:Name="PART_Track" IsDirectionReversed="True" Focusable="False">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                Style="{StaticResource ScrollPageButtonStyle}" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                  <Thumb Style="{StaticResource ScrollThumbStyle}" />
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                Style="{StaticResource ScrollPageButtonStyle}" />
                </Track.IncreaseRepeatButton>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="46" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0"
            Background="#FF101A22"
            BorderBrush="#FF202E37"
            BorderThickness="0,0,0,1">
      <Grid Margin="14,0,8,0">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Button Style="{StaticResource CaptionButtonStyle}"
                  Width="30"
                  Margin="0,0,5,0"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True"
                  Click="OnSystemMenuClick"
                  AutomationProperties.Name="窗口菜单">
            <Image Source="pack://application:,,,/SnapEdge;component/Assets/SnapEdge.ico"
                   Width="18" Height="18" />
          </Button>
          <TextBlock Text="SnapEdge" FontSize="13" FontWeight="SemiBold" />
          <Border Width="1" Height="15" Background="#FF33444F" Margin="12,0" />
          <TextBlock Text="设置" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
        </StackPanel>
        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Style="{StaticResource CaptionButtonStyle}"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True"
                  Click="OnMinimizeClick"
                  AutomationProperties.Name="最小化">
            <Path Data="M 3,8 L 13,8"
                  Width="16" Height="16"
                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                  StrokeThickness="1.2"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
          </Button>
          <Button x:Name="MaximizeRestoreButton"
                  Style="{StaticResource CaptionButtonStyle}"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True"
                  Click="OnMaximizeRestoreClick"
                  AutomationProperties.Name="最大化或还原">
            <Path x:Name="MaximizeGlyph"
                  Data="M 3,3 H 13 V 13 H 3 Z"
                  Width="14" Height="14"
                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                  StrokeThickness="1.2" />
          </Button>
          <Button Style="{StaticResource CloseCaptionButtonStyle}"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True"
                  Click="OnCloseClick"
                  AutomationProperties.Name="关闭">
            <Path Data="M 4,4 L 12,12 M 12,4 L 4,12"
                  Width="16" Height="16"
                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                  StrokeThickness="1.2"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1" Margin="28,18,28,12">
      <StackPanel>
        <TextBlock Text="偏好设置" FontSize="24" FontWeight="SemiBold" />
        <TextBlock Text="管理截图、悬浮按钮和保存行为" Margin="0,4,0,0" FontSize="13" Foreground="{StaticResource TextMutedBrush}" />
      </StackPanel>
      <Border HorizontalAlignment="Right"
              VerticalAlignment="Center"
              Background="#FF162A2A"
              BorderBrush="#FF28413F"
              BorderThickness="1"
              CornerRadius="10"
              Padding="11,7">
        <StackPanel Orientation="Horizontal">
          <Ellipse Width="7" Height="7" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center" />
          <TextBlock Text="本地设置" Margin="7,0,0,0" FontSize="12" Foreground="#FFC1DED8" />
        </StackPanel>
      </Border>
    </Grid>

    <ScrollViewer x:Name="SettingsScrollViewer"
                  Grid.Row="2"
                  Margin="16,0,12,0"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  PanningMode="VerticalOnly"
                  CanContentScroll="False">
      <StackPanel Margin="12,0,10,10">
        <Border Style="{StaticResource SectionCardStyle}">
          <StackPanel>
            <TextBlock Text="保存位置" FontSize="16" FontWeight="SemiBold" />
            <TextBlock Text="截图将以 PNG 格式写入此文件夹。"
                       Margin="0,3,0,14" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBox x:Name="SaveDirectoryTextBox"
                       IsReadOnly="True"
                       ToolTip="截图保存目录" />
              <Button Grid.Column="1"
                      Content="选择文件夹"
                      Margin="10,0,0,0"
                      Click="OnBrowseDirectory" />
            </Grid>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource SectionCardStyle}">
          <StackPanel>
            <TextBlock Text="图像裁剪" FontSize="16" FontWeight="SemiBold" />
            <TextBlock Text="分别控制窗口边缘和画面黑边的处理。"
                       Margin="0,3,0,10" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />

            <CheckBox x:Name="CropClientAreaCheckBox"
                      Checked="OnSettingChanged"
                      Unchecked="OnSettingChanged">
              <StackPanel>
                <TextBlock Text="仅保留窗口客户区" FontWeight="SemiBold" />
                <TextBlock Text="裁掉标题栏和外侧边框" Margin="0,2,0,0" FontSize="12" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" />
              </StackPanel>
            </CheckBox>

            <CheckBox x:Name="AutoCropBlackCheckBox"
                      Checked="OnSettingChanged"
                      Unchecked="OnSettingChanged">
              <StackPanel>
                <TextBlock Text="自动裁掉近黑色边缘" FontWeight="SemiBold" />
                <TextBlock Text="检测证据不足时会保留原图" Margin="0,2,0,0" FontSize="12" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" />
              </StackPanel>
            </CheckBox>

            <Border Margin="0,5,0,0"
                    Padding="13,9"
                    Background="#FF0F181F"
                    BorderBrush="#FF202F38"
                    BorderThickness="1"
                    CornerRadius="11">
              <StackPanel>
                <Grid Margin="0,2,0,5">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="126" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="48" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="黑边亮度阈值" FontSize="12" FontWeight="SemiBold" />
                    <TextBlock Text="越低越保守" Margin="0,2,0,0" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                  </StackPanel>
                  <Slider x:Name="BrightnessSlider"
                          Grid.Column="1"
                          Minimum="0" Maximum="64"
                          TickFrequency="1"
                          IsSnapToTickEnabled="True"
                          ValueChanged="OnThresholdChanged" />
                  <Border Grid.Column="2" Background="#FF1A2931" CornerRadius="7" Padding="7,4" HorizontalAlignment="Right">
                    <TextBlock x:Name="BrightnessValue" TextAlignment="Center" FontSize="12" FontWeight="SemiBold" />
                  </Border>
                </Grid>

                <Grid Margin="0,5,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="126" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="48" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="颜色容差" FontSize="12" FontWeight="SemiBold" />
                    <TextBlock Text="忽略轻微色偏" Margin="0,2,0,0" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                  </StackPanel>
                  <Slider x:Name="ToleranceSlider"
                          Grid.Column="1"
                          Minimum="0" Maximum="64"
                          TickFrequency="1"
                          IsSnapToTickEnabled="True"
                          ValueChanged="OnThresholdChanged" />
                  <Border Grid.Column="2" Background="#FF1A2931" CornerRadius="7" Padding="7,4" HorizontalAlignment="Right">
                    <TextBlock x:Name="ToleranceValue" TextAlignment="Center" FontSize="12" FontWeight="SemiBold" />
                  </Border>
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource SectionCardStyle}">
          <StackPanel>
            <TextBlock Text="保存与提示" FontSize="16" FontWeight="SemiBold" />
            <TextBlock Text="选择截图后的附加操作。"
                       Margin="0,3,0,9" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
            <CheckBox x:Name="CopyToClipboardCheckBox"
                      Content="截图后复制到剪贴板"
                      Checked="OnSettingChanged"
                      Unchecked="OnSettingChanged" />
            <CheckBox x:Name="CaptureFeedbackCheckBox"
                      Content="截图完成后显示提示"
                      Checked="OnSettingChanged"
                      Unchecked="OnSettingChanged" />
          </StackPanel>
        </Border>

        <Border Style="{StaticResource SectionCardStyle}">
          <StackPanel>
            <TextBlock Text="悬浮按钮" FontSize="16" FontWeight="SemiBold" />
            <TextBlock Text="调整按钮的停靠方式和外观。"
                       Margin="0,3,0,9" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
            <CheckBox x:Name="AutoSnapCheckBox"
                      Content="拖动后吸附到左右屏幕边缘"
                      Checked="OnSettingChanged"
                      Unchecked="OnSettingChanged" />
            <CheckBox x:Name="AutoPeekCheckBox"
                      Content="贴边空闲后半隐藏，靠近时滑出"
                      Checked="OnSettingChanged"
                      Unchecked="OnSettingChanged" />

            <Border Margin="0,5,0,10"
                    Padding="13,8"
                    Background="#FF0F181F"
                    BorderBrush="#FF202F38"
                    BorderThickness="1"
                    CornerRadius="11">
              <StackPanel>
                <Grid Margin="0,1,0,5">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="126" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="54" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="按钮透明度" FontSize="12" FontWeight="SemiBold" />
                    <TextBlock Text="空闲时的可见程度" Margin="0,2,0,0" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                  </StackPanel>
                  <Slider x:Name="OpacitySlider"
                          Grid.Column="1"
                          Minimum="0.45" Maximum="1"
                          TickFrequency="0.05"
                          ValueChanged="OnAppearanceChanged" />
                  <Border Grid.Column="2" Background="#FF1A2931" CornerRadius="7" Padding="7,4" HorizontalAlignment="Right">
                    <TextBlock x:Name="OpacityValue" TextAlignment="Center" FontSize="12" FontWeight="SemiBold" />
                  </Border>
                </Grid>
                <Grid Margin="0,5,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="126" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="54" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="按钮大小" FontSize="12" FontWeight="SemiBold" />
                    <TextBlock Text="48 至 96 像素" Margin="0,2,0,0" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                  </StackPanel>
                  <Slider x:Name="ButtonSizeSlider"
                          Grid.Column="1"
                          Minimum="48" Maximum="96"
                          TickFrequency="2"
                          IsSnapToTickEnabled="True"
                          ValueChanged="OnAppearanceChanged" />
                  <Border Grid.Column="2" Background="#FF1A2931" CornerRadius="7" Padding="7,4" HorizontalAlignment="Right">
                    <TextBlock x:Name="ButtonSizeValue" TextAlignment="Center" FontSize="12" FontWeight="SemiBold" />
                  </Border>
                </Grid>
              </StackPanel>
            </Border>

            <CheckBox x:Name="LaunchAtStartupCheckBox"
                      Content="登录 Windows 后自动启动"
                      Checked="OnStartupChanged"
                      Unchecked="OnStartupChanged" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="3"
            BorderBrush="#FF202E37"
            BorderThickness="0,1,0,0"
            Padding="28,12,28,16">
      <TextBlock Text="轻触悬浮按钮截图 · 长按或右键打开设置"
                 Foreground="{StaticResource TextMutedBrush}"
                 FontSize="12"
                 TextWrapping="Wrap" />
    </Border>
  </Grid>
</Window>
