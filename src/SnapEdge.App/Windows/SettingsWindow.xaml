<Window x:Class="SnapEdge.App.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SnapEdge 设置"
        Width="520" Height="760" MinWidth="440" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#FF111820" Foreground="#FFF3F6F8"
        FontFamily="Segoe UI, Microsoft YaHei UI">
  <Window.Resources>
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="#FFF3F6F8" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="#FFF3F6F8" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,2" />
    </Style>
    <Style TargetType="Slider">
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style TargetType="Button">
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="Foreground" Value="#FF14202A" />
      <Setter Property="Background" Value="#FF75D6C2" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FontSize" Value="14" />
    </Style>
  </Window.Resources>
  <Grid Margin="22">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,18">
      <TextBlock Text="SnapEdge" FontSize="26" FontWeight="SemiBold" />
      <TextBlock Text="截图会保存为 PNG。设置会自动保存。" Foreground="#FFB1BDC6" Margin="0,4,0,0" />
    </StackPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="0,0,20,0">
        <TextBlock Text="保存" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,8" />
        <Grid Margin="0,0,0,18">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBox x:Name="SaveDirectoryTextBox" Height="42" IsReadOnly="True" VerticalContentAlignment="Center"
                   Background="#FF1D2933" Foreground="#FFE9EFF3" BorderBrush="#FF3A4A57" Padding="10,4" />
          <Button Grid.Column="1" Content="选择文件夹" Margin="10,0,0,0" Click="OnBrowseDirectory" />
        </Grid>

        <TextBlock Text="图像处理" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,8" />
        <CheckBox x:Name="CropClientAreaCheckBox" Content="仅保留窗口客户区（裁掉标题栏和边框）" Checked="OnSettingChanged" Unchecked="OnSettingChanged" />
        <CheckBox x:Name="AutoCropBlackCheckBox" Content="自动检测并裁掉近黑色边缘" Checked="OnSettingChanged" Unchecked="OnSettingChanged" />
        <Grid Margin="26,0,0,2">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="48" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="黑边亮度阈值" Foreground="#FFB1BDC6" />
          <Slider x:Name="BrightnessSlider" Grid.Column="1" Minimum="0" Maximum="64" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="OnThresholdChanged" />
          <TextBlock x:Name="BrightnessValue" Grid.Column="2" TextAlignment="Right" Foreground="#FFB1BDC6" />
        </Grid>
        <Grid Margin="26,0,0,16">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="48" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="颜色容差" Foreground="#FFB1BDC6" />
          <Slider x:Name="ToleranceSlider" Grid.Column="1" Minimum="0" Maximum="64" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="OnThresholdChanged" />
          <TextBlock x:Name="ToleranceValue" Grid.Column="2" TextAlignment="Right" Foreground="#FFB1BDC6" />
        </Grid>

        <TextBlock Text="保存与提示" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,8" />
        <CheckBox x:Name="CopyToClipboardCheckBox" Content="截图后复制到剪贴板" Checked="OnSettingChanged" Unchecked="OnSettingChanged" />
        <CheckBox x:Name="CaptureFeedbackCheckBox" Content="截图完成后显示提示" Checked="OnSettingChanged" Unchecked="OnSettingChanged" />

        <TextBlock Text="悬浮按钮" FontSize="17" FontWeight="SemiBold" Margin="0,12,0,8" />
        <CheckBox x:Name="AutoSnapCheckBox" Content="拖动后吸附到最近的左右屏幕边缘" Checked="OnSettingChanged" Unchecked="OnSettingChanged" />
        <CheckBox x:Name="AutoPeekCheckBox" Content="贴边后自动半隐藏，靠近时滑出" Checked="OnSettingChanged" Unchecked="OnSettingChanged" />
        <Grid Margin="0,0,0,4">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="52" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="按钮透明度" Foreground="#FFB1BDC6" />
          <Slider x:Name="OpacitySlider" Grid.Column="1" Minimum="0.45" Maximum="1" TickFrequency="0.05" ValueChanged="OnAppearanceChanged" />
          <TextBlock x:Name="OpacityValue" Grid.Column="2" TextAlignment="Right" Foreground="#FFB1BDC6" />
        </Grid>
        <Grid Margin="0,0,0,16">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="52" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="按钮大小" Foreground="#FFB1BDC6" />
          <Slider x:Name="ButtonSizeSlider" Grid.Column="1" Minimum="48" Maximum="96" TickFrequency="2" IsSnapToTickEnabled="True" ValueChanged="OnAppearanceChanged" />
          <TextBlock x:Name="ButtonSizeValue" Grid.Column="2" TextAlignment="Right" Foreground="#FFB1BDC6" />
        </Grid>
        <CheckBox x:Name="LaunchAtStartupCheckBox" Content="登录 Windows 后自动启动" Checked="OnStartupChanged" Unchecked="OnStartupChanged" />
      </StackPanel>
    </ScrollViewer>
    <TextBlock Grid.Row="2" Text="轻触悬浮按钮截图 · 长按或右键打开此设置" Foreground="#FF80919E" Margin="0,14,0,0" TextWrapping="Wrap" />
  </Grid>
</Window>
