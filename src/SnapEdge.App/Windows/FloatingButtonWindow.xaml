<Window x:Class="SnapEdge.App.Windows.FloatingButtonWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SnapEdge"
        Width="62" Height="62"
        WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False"
        Topmost="True" Focusable="False"
        WindowStartupLocation="Manual"
        PreviewMouseLeftButtonDown="OnMouseLeftDown"
        PreviewMouseLeftButtonUp="OnMouseLeftUp"
        PreviewMouseMove="OnMouseMove"
        PreviewMouseRightButtonUp="OnMouseRightUp"
        PreviewTouchDown="OnTouchDown"
        PreviewTouchMove="OnTouchMove"
        PreviewTouchUp="OnTouchUp">
  <Grid Background="Transparent" ToolTip="轻触截图 · 长按设置 · 拖动移动">
    <Border x:Name="ButtonSurface"
            Margin="2"
            CornerRadius="32"
            Background="#EE17212B"
            BorderBrush="#6675D6C2"
            BorderThickness="1.5">
      <Viewbox Width="27" Height="27" Stretch="Uniform">
        <Grid Width="28" Height="28">
          <Path Data="M 3,9 L 8,9 L 10,6 L 18,6 L 20,9 L 25,9 L 25,22 L 3,22 Z"
                Stroke="#FF75D6C2" StrokeThickness="1.8" StrokeLineJoin="Round" />
          <Ellipse Width="8" Height="8" Stroke="#FF75D6C2" StrokeThickness="1.8" />
          <Ellipse Width="2.2" Height="2.2" Fill="#FF75D6C2" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,5,0" />
        </Grid>
      </Viewbox>
    </Border>
  </Grid>
</Window>
